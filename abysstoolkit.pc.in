prefix=@PREFIX@
includedir=@INCLUDE@
libdir=@LIBDIR@

Name: abysstoolkit
URL: https://github.com/AbyssWM/abysstoolkit
Description: A modern C++ Wayland-native GUI toolkit
Version: @ABYSSTOOLKIT_VERSION@
Requires: @ABYSSTOOLKIT_PUBLIC_REQUIRES@
Requires.private: @ABYSSTOOLKIT_PRIVATE_REQUIRES@
Cflags: -I${includedir}
Libs: -L${libdir} -labysstoolkit
